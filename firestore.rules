rules_version = '2';
// Règles de la base Firestore de Mogette. La mise à jour du matin les publie elle-même (alertes.py, avec la clé de
// service FIREBASE_COMPTE) : modifier ce fichier suffit.
service cloud.firestore {
  match /databases/{database}/documents {

    // Réglages de chaque personne : elle seule les lit, les écrit ou les supprime.
    match /comptes/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['donnees', 'maj'])
        && request.resource.data.donnees is string
        && request.resource.data.donnees.size() < 800000
        && request.resource.data.maj is int;

      // Téléphones abonnés aux notifications de ce compte (adresse d'envoi Web Push).
      match /appareils/{appareil} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['push', 'nom', 'maj'])
          && request.resource.data.push is string && request.resource.data.push.size() < 4000
          && request.resource.data.nom is string && request.resource.data.nom.size() < 40
          && request.resource.data.maj is int;
      }
    }

    // Listes de courses partagées : seuls les membres (des comptes) la lisent et la modifient.
    // Qui a le lien (le numéro de la liste) peut s'y ajouter lui-même, 10 personnes au plus.
    match /listes/{liste} {
      allow read: if request.auth != null && request.auth.uid in resource.data.membres;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['membres', 'proprio', 'noms', 'donnees', 'maj'])
        && request.resource.data.membres == [request.auth.uid]
        && request.resource.data.proprio == request.auth.uid
        && request.resource.data.donnees is string && request.resource.data.donnees.size() < 800000;
      allow update: if request.auth != null && (
        // un membre modifie la liste ou son prénom, sans toucher aux membres
        (request.auth.uid in resource.data.membres
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['donnees', 'maj', 'noms'])
          && request.resource.data.donnees is string && request.resource.data.donnees.size() < 800000)
        // quelqu'un qui a le lien s'ajoute lui-même
        || (!(request.auth.uid in resource.data.membres)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membres'])
          && request.resource.data.membres.hasAll(resource.data.membres)
          && request.resource.data.membres.size() == resource.data.membres.size() + 1
          && request.auth.uid in request.resource.data.membres
          && resource.data.membres.size() < 10)
        // un membre s'en va
        || (request.auth.uid in resource.data.membres
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membres', 'noms'])
          && !(request.auth.uid in request.resource.data.membres)
          && request.resource.data.membres.hasAll(resource.data.membres.removeAll([request.auth.uid]))
          && request.resource.data.membres.size() == resource.data.membres.size() - 1)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.proprio;
    }

    // Connexion dans l'appli Android ou iPhone : Google refuse de se connecter dans l'appli, alors elle se fait dans le
    // navigateur, qui dépose ici le jeton Google sous un numéro tiré au hasard par l'appli (impossible à deviner).
    // L'appli le lit puis l'efface ; personne ne peut lister ces documents, et ils ne se lisent que 15 minutes.
    match /liaisons/{code} {
      allow get: if resource == null || resource.data.t > request.time - duration.value(15, 'm');
      allow create: if code.size() >= 32 && code.size() <= 64
        && request.resource.data.keys().hasOnly(['jeton', 't'])
        && request.resource.data.jeton is string && request.resource.data.jeton.size() < 5000
        && request.resource.data.t == request.time;
      allow delete: if true;
    }

    // Erreurs des téléphones (rapport technique anonyme) et messages « Une idée, un problème ? » : on peut seulement en
    // déposer ; personne ne peut les lire depuis l'appli (le propriétaire les lit dans la console Firebase).
    match /erreurs/{id} {
      allow create: if id.size() <= 40
        && request.resource.data.keys().hasOnly(['m', 's', 'l', 'p', 'v', 'ver', 'ua', 'app', 't'])
        && request.resource.data.m is string && request.resource.data.m.size() <= 300
        && request.resource.data.get('l', 0) is int
        && request.resource.data.get('s', '').size() <= 200 && request.resource.data.get('p', '').size() <= 1500
        && request.resource.data.get('v', '').size() <= 40 && request.resource.data.get('ver', '').size() <= 20
        && request.resource.data.get('ua', '').size() <= 200 && request.resource.data.get('app', '').size() <= 10
        && request.resource.data.t == request.time;
    }
    match /retours/{id} {
      allow create: if id.size() <= 40
        && request.resource.data.keys().hasOnly(['msg', 'contact', 'v', 'ver', 'ua', 'app', 't'])
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 2000
        && request.resource.data.get('contact', '').size() <= 120 && request.resource.data.get('v', '').size() <= 20
        && request.resource.data.get('ver', '').size() <= 20 && request.resource.data.get('ua', '').size() <= 200
        && request.resource.data.get('app', '').size() <= 10
        && request.resource.data.t == request.time;
    }

    // Clé publique d'envoi des notifications (la clé privée reste dans config/push, fermé à tous).
    match /config/public {
      allow read: if true;
    }
  }
}
