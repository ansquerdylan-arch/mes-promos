rules_version = '2';
// Règles de la base Firestore de Mogette, à coller dans la console Firebase :
// Firestore Database > Règles > (tout remplacer) > Publier.
// Chaque personne ne lit, n'écrit et ne supprime que son propre document comptes/<son identifiant>,
// qui ne contient que ses réglages (texte JSON, moins de 800 Ko) et la date du dernier enregistrement.
service cloud.firestore {
  match /databases/{database}/documents {
    match /comptes/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['donnees', 'maj'])
        && request.resource.data.donnees is string
        && request.resource.data.donnees.size() < 800000
        && request.resource.data.maj is int;
    }
  }
}
